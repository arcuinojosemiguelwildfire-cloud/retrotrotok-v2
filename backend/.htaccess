# Root guard for Hostinger / Apache deployments when /backend is inside web root.
# Recommended: point document root directly to /backend/public.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny direct HTTP access to sensitive backend internals if exposed above public/
    RewriteRule ^(\.env|composer\.(json|lock)|phpunit\.xml|bin/|database/|docs/|src/|tests/|vendor/) - [F,L,NC]
</IfModule>

<FilesMatch "^(\.env.*|composer\.(json|lock)|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

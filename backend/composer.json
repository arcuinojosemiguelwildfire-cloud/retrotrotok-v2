{
  "name": "retrotok/cloud-backend",
  "description": "Provider-independent PHP 8.x REST API and R2 object storage boundary for RetroTok Cloud Integration.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-simplexml": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "RetroTok\\Cloud\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RetroTok\\Cloud\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "migrate": "php bin/migrate.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
